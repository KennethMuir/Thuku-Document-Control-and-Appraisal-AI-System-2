# API database connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# API server port
PORT=4000

# Public web application origin; no trailing slash
WEB_ORIGIN=http://localhost:3000

# Resend email delivery
# Obtain the API key from your Resend dashboard. Never commit real credentials.
RESEND_API_KEY=re_your_api_key_here

# Use a sender address on a domain verified in Resend.
# Example format only; replace with your verified sender address.
RESEND_FROM_EMAIL=Document Appraisal <no-reply@example.com>